# AgentGuard - Environment Configuration Example
# Copy this file to .env and fill in your values

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_TITLE=AgentGuard

# Backend
DATABASE_URL=sqlite:///./agentguard.db
SECRET_KEY=your-secret-key-change-in-production
# Admin API key for privileged operations (credential registration, policy management, revocation)
# MUST be set in production. No default for security.
ADMIN_API_KEY=
CORS_ORIGINS=http://localhost:5173
DEBUG=true

# PayPal (Phase 2+ - not used in Phase 1)
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com